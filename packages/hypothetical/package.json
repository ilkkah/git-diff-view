{
  "name": "@git-diff-view/hypothetical",
  "description": "@git-diff-view/hypothetical",
  "author": "MrWangJustToDo",
  "license": "MIT",
  "version": "0.0.1",
  "main": "./dist/hypothetical-git-diff-view.js",
  "type": "commonjs",
  "types": "index.d.ts",
  "files": [
    "src",
    "dist",
    "styles"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrWangJustToDo/git-diff-view.git",
    "directory": "packages/hypothetical"
  },
  "scripts": {
    "build": "webpack",
    "gen:css1": "postcss src/tailwind.css -o dist/css/diff-view.css",
    "gen:css2": "postcss src/tailwind_pure.css -o dist/css/diff-view-pure.css",
    "gen:css": "npm run gen:css1 && npm run gen:css2"
  },
  "homepage": "https://mrwangjusttodo.github.io/git-diff-view",
  "exports": {
    ".": {
      "require": "./dist/hypothetical-git-diff-view.js",
      "types": "./index.d.ts"
    },
    "./styles/*": "./dist/css/*",
    "./package.json": "./package.json"
  },
  "keywords": [
    "diff component",
    "hypothetical diff component"
  ],
  "dependencies": {
    "@git-diff-view/core": "^0.0.32",
    "mustache": "^4.2.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "postcss-cli": "^11.0.0",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.5.1",
    "raw-loader": "^4.0.2",
    "babel-loader": "^9.1.3",
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7"
  }
}
